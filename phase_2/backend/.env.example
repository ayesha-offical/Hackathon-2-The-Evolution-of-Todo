# ============================================================================
# BACKEND CONFIGURATION - COPY THIS TO .env AND FILL IN YOUR VALUES
# ============================================================================

# PostgreSQL Database URL (use asyncpg driver for FastAPI)
# Example: postgresql+asyncpg://username:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# JWT / Better Auth Secret - Generate a secure random string (min 32 chars)
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-minimum-32-characters

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Environment type (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:8000/api/v1/auth

# Email (Optional - if using SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
