# ============================================================================
# BACKEND CONFIGURATION - COPY THIS TO .env AND FILL IN YOUR VALUES
# ============================================================================

# PostgreSQL Database URL (use asyncpg driver for FastAPI)
# Example: postgresql+asyncpg://username:password@host:5432/dbname
DATABASE_URL=
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=BETTER_AUTH_URL=https://focus-hub-omega.vercel.app/# Base URL of your app

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Environment type (development, staging, production)
ENVIRONMENT=production
LOG_LEVEL=DEBUG

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_URL=https:
NEXT_PUBLIC_API_BASE_URL=https:
NEXT_PUBLIC_BETTER_AUTH_URL=https:/api/v1/auth

# Email (Optional - if using SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
